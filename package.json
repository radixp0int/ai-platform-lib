{
  "name": "ai-platform-lib",
  "version": "0.0.0",
  "private": true,
  "description": "The AI platform's component library: brand, primitives, components and recipes, with chat and workflows as their own areas. Source-only; each app's Vite compiles it. One Storybook shows all of it.",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./chat": "./src/chat/index.ts",
    "./workflows": "./src/workflows/index.ts",
    "./styles.css": "./src/styles.css",
    "./chat.css": "./src/chat/chat.css",
    "./workflows.css": "./src/workflows/workflows.css",
    "./widget.css": "./src/chat/components/chat-widget/widget.css",
    "./brand/tokens.css": "./brand/tokens.css",
    "./brand/head.html": "./brand/head.html"
  },
  "scripts": {
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o storybook-static",
    "typecheck": "tsc -p tsconfig.lib.json && tsc -p tsconfig.json",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "screenshots": "node scripts/story-screenshots.mjs storybook-static .screenshots/current",
    "screenshots:compare": "node scripts/compare-screenshots.mjs .screenshots/baseline .screenshots/current",
    "prepare": "node .husky/install.mjs",
    "test:tablet-workflow": "node scripts/check-tablet-workflow.mjs",
    "test:static-workflows": "node scripts/check-static-workflows.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:components": "playwright test src",
    "test:e2e:stories": "playwright test tests",
    "test:e2e:ui": "playwright test --ui",
    "serve-storybook": "node scripts/serve-storybook.mjs"
  },
  "dependencies": {
    "@aiden0z/pptx-renderer": "^1.3.0",
    "@tanstack/react-virtual": "^3.14.13",
    "@xyflow/react": "^12.11.6",
    "beautiful-mermaid": "^1.1.3",
    "docx-preview": "^0.4.1",
    "dompurify": "^3.4.12",
    "react-datepicker": "^9.1.0",
    "react-markdown": "^10.1.0",
    "react-pdf": "^11.0.0",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/react-vite": "^10.6.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "husky": "^9.1.7",
    "jsdom": "^30.1.2",
    "lint-staged": "^16.4.0",
    "oxfmt": "0.70.0",
    "oxlint": "^1.74.0",
    "playwright": "^1.63.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "storybook": "^10.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.3"
  },
  "peerDependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs}": [
      "oxfmt --no-error-on-unmatched-pattern",
      "oxlint --fix --max-warnings=0"
    ],
    "*.{json,css,md}": "oxfmt --no-error-on-unmatched-pattern"
  }
}
